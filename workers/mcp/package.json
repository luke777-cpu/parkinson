{
  "name": "yakhyo-mcp-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "약효일지 MCP 브리지 — Cloudflare Worker (/mcp, Streamable HTTP 무상태)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "dev": "wrangler dev --env staging",
    "deploy:staging:dry": "wrangler deploy --env staging --dry-run --outdir dist"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "jose": "6.2.18",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261121.1",
    "typescript": "5.9.3",
    "vitest": "5.1.1",
    "wrangler": "4.166.0"
  }
}
